#!/usr/bin/env php
<?php

/**
 * Test fixture: a stand-in for Laravel's artisan that satisfies the commands
 * install.php invokes (key:generate, storage:link). Behaviour is the bare
 * minimum needed for the installer's success-path assertions.
 */

$cmd = $argv[1] ?? '';

switch ($cmd) {
    case 'key:generate':
        // Like Laravel, overwrite APP_KEY in .env so tests can tell whether
        // the installer rotated an existing key.
        $env = __DIR__ . '/.env';
        $key = 'base64:' . base64_encode(random_bytes(32));
        file_put_contents($env, preg_replace('/^APP_KEY=.*$/m', 'APP_KEY=' . $key, (string) file_get_contents($env)));
        echo "Application key set successfully.\n";
        exit(0);
    case 'storage:link':
        echo "The [public/storage] link has been connected.\n";
        exit(0);
    default:
        fwrite(STDERR, "fake artisan: unknown command '{$cmd}'\n");
        exit(1);
}
